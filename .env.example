# Copy this file to .env and fill in your own values.
# Get an API key at https://openrouter.ai/keys

# Required
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# Optional — model used by explain_control() for audit findings
OPENROUTER_MODEL=google/gemma-3-27b-it:free

# Optional — comma-separated list of free-tier model IDs used for per-chunk
# ensemble voting. Only set this if you know the IDs are valid free-tier
# models on OpenRouter; an invalid override silently disables LLM voting.
# OPENROUTER_VOTING_MODELS=meta-llama/llama-3.1-8b-instruct:free,google/gemma-2-9b-it:free,mistralai/mistral-small-24b-instruct-2501:free
